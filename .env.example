# ==============================================================================
# Multichannel Inventory Control Platform - Environment Template
# SAFE DEVELOPMENT DEFAULTS ONLY - NEVER COMMIT REAL CREDENTIALS
# ==============================================================================

# Node Environment
NODE_ENV=development

# Supabase Platform (Local Development Defaults)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhYmNkZWZnaGk...placeholder_anon_key
SUPABASE_SECRET_KEY=eyJhYmNkZWZnaGk...placeholder_service_role_key

# PostgreSQL Database (Pooled & Direct Connection Strings)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Redis & BullMQ Queue Configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Service Ports & URLs
PORT=4000
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Stripe Billing (Development Sandbox Placeholders)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
